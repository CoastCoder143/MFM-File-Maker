// MIKE 21 FM input file
// Created on 2026-01-01

[SETUP]
version = 1.0
project_name = "Test Project"

[DREDGER_1]
enabled = true
file_name = "test_data/input_dfs0/dredger_data.dfs0|"
time_step = 3600

[DOMAIN]
grid_type = "flexible_mesh"
coordinate_system = "LONG/LAT"

[MORPHOLOGY]
morphology_enabled = true
sediment_transport = "sand"

[OUTPUTS]
number_of_outputs = 2

[OUTPUT_1]
file_name = "test_data/output_dfsu/sample.dfsu"
output_type = "bed_level"
output_interval = 3600

[OUTPUT_2]
file_name = "other_output.dfsu"
output_type = "velocity"

[HYDRODYNAMICS]
enabled = true

[OUTPUTS]
number_of_outputs = 1

[OUTPUT_1]
file_name = "hydro_output.dfsu"
output_type = "water_level"
